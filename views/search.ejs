<div class="author">
  <h1 class="author__heading">Search Results</h1>
  <% if (typeof searchTerm !== "undefined" && searchTerm) { %>
    <p class="author__body">Results for "<%= searchTerm %>"</p>
  <% } %>
</div>

<section class="articles">
  <% if (!data.length) { %>
    <p>No posts found.</p>
  <% } %>

  <ul class="article-ul">
    <% data.forEach(post => { %>
      <li>
        <a href="/post/<%= post._id %>">
          <span><%= post.title %></span>
          <span class="article-list__date"><%= post.createdAt.toDateString() %></span>
        </a>
      </li>
    <% }) %>
  </ul>
</section>
